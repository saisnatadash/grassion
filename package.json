{
  "name": "grassion",
  "version": "1.0.0",
  "private": true,
  "description": "Grassion — Measure whether your AI coding tool spend is paying off.",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm -r start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @grassion/db generate",
    "db:migrate": "pnpm --filter @grassion/db migrate",
    "db:push": "pnpm --filter @grassion/db push",
    "db:studio": "pnpm --filter @grassion/db studio",
    "db:status": "pnpm --filter @grassion/db status"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "prettier": "^3.3.3",
    "@types/node": "^26.6.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.7.0",
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "axios": ">=1.15.2",
      "devalue": ">=5.8.1",
      "tinypool": ">=2.1.2",
      "body-parser": ">=1.20.9",
      "follow-redirects": ">=1.16.2",
      "fast-uri": ">=3.1.6"
    }
  }
}
