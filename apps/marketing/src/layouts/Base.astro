---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const { title, description, ogImage } = Astro.props
const fullTitle = title === 'Grassion' ? title : `${title} · Grassion`
const desc =
  description ??
  'Grassion measures whether your AI coding tool spend is paying off. GitHub App. 2-minute install. No code leaves your servers.'
const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const og = ogImage ?? '/og.png'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <link rel="icon" type="image/png" href="/Grassion%20single%20logo%20(1).png" />
    <meta name="theme-color" content="#0F172A" />
  </head>
  <body class="min-h-screen bg-[#0a0a0a]">
    <Nav />
    <main class="mx-auto max-w-3xl px-6 py-14 sm:py-20">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Grassion first-party analytics — no IP, no cookies, no third-party data.
      ;(function () {
        var API = 'https://grassion-api.fly.dev'
        var SID_KEY = 'g_sid'
        function getSid() {
          try { var s = sessionStorage.getItem(SID_KEY); if (s) return s } catch (_) {}
          var id = Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2)
          try { sessionStorage.setItem(SID_KEY, id) } catch (_) {}
          return id
        }
        var sid = getSid()
        function track(name, meta) {
          try {
            var payload = JSON.stringify({ events: [{ session_id: sid, event_name: name, source: 'marketing', page: location.pathname, referrer: document.referrer || '', metadata: meta || {} }] })
            if (navigator.sendBeacon) { navigator.sendBeacon(API + '/api/track', new Blob([payload], { type: 'application/json' })) }
            else { fetch(API + '/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(function(){}) }
          } catch (_) {}
        }
        track('page_view', { title: document.title })
        document.addEventListener('click', function(e) {
          var el = e.target && e.target.closest && e.target.closest('a, button')
          if (!el) return
          var label = el.getAttribute('data-track') || (el.innerText || '').trim().slice(0, 60)
          track('click', { label: label, tag: el.tagName.toLowerCase() })
        })
        window._gtrack = track
      })()
    </script>
    <script>
      ;(function () {
        // Capture ?ref= from URL and store in cookie (30 days, readable by JS)
        var params = new URLSearchParams(window.location.search)
        var urlRef = params.get('ref')
        if (urlRef) {
          document.cookie =
            'grassion_ref=' +
            encodeURIComponent(urlRef) +
            ';max-age=' +
            30 * 24 * 60 * 60 +
            ';path=/;SameSite=Lax'
        }
        // Read stored ref
        var m = document.cookie.match(/(?:^|;\s*)grassion_ref=([^;]+)/)
        var ref = m ? decodeURIComponent(m[1]) : null
        if (!ref) return
        var refStr = ref
        // Append ?ref= to all OAuth / login links so it reaches the API
        var API = 'https://grassion-api.fly.dev'
        document.querySelectorAll('a').forEach(function (a) {
          var href = a.getAttribute('href')
          if (!href) return
          if (href.indexOf('auth/github') !== -1) {
            var u = new URL(href, window.location.href)
            u.searchParams.set('ref', refStr)
            a.setAttribute('href', u.toString())
          } else if (href.indexOf('/login') !== -1) {
            a.setAttribute('href', API + '/auth/github?ref=' + encodeURIComponent(refStr))
          }
        })
      })()
    </script>
  </body>
</html>
