---
const year = new Date().getFullYear()
const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://app.grassion.com'
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Security at Grassion</title>
  <meta name="description" content="Grassion analyzes engineering workflow metadata. We never read or store your source code. Read about our security practices." />
  <link rel="icon" type="image/png" href="/Grassion%20single%20logo%20(1).png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:ital,opsz,wght@0,9..40,200;0,9..40,300;0,9..40,400;1,9..40,300&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black: #0a0a0a;
      --white: #ffffff;
      --green: #22c55e;
      --green-dim: rgba(34, 197, 94, 0.12);
      --green-border: rgba(34, 197, 94, 0.25);
      --red-dim: rgba(239, 68, 68, 0.10);
      --red-border: rgba(239, 68, 68, 0.20);
      --dim: rgba(255,255,255,0.62);
      --dimmer: rgba(255,255,255,0.40);
      --line: rgba(255,255,255,0.10);
      --card-bg: rgba(255,255,255,0.03);
      --card-border: rgba(255,255,255,0.08);
    }

    html, body {
      background: var(--black);
      color: var(--white);
      font-family: 'DM Sans', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── HEADER ─────────────────────────────── */
    header {
      position: fixed;
      top: 0; left: 0; right: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 52px;
      z-index: 100;
      border-bottom: 1px solid var(--line);
      background: rgba(0,0,0,0.85);
      backdrop-filter: blur(16px);
    }

    nav { display: flex; gap: 40px; align-items: center; }
    nav a {
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--dim);
      text-decoration: none;
      transition: color 0.2s;
    }
    nav a:hover { color: var(--white); }

    .cta-btn {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--black);
      background: var(--white);
      border: none;
      border-radius: 6px;
      padding: 8px 18px;
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .cta-btn:hover { opacity: 0.85; color: var(--black); }
    .cta-btn { cursor: pointer; }

    /* ── MAIN ───────────────────────────────── */
    main {
      padding: 120px 52px 80px;
      max-width: 900px;
      margin: 0 auto;
    }

    /* ── HERO ───────────────────────────────── */
    .hero {
      text-align: center;
      margin-bottom: 80px;
    }

    .eyebrow {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--green);
      margin-bottom: 24px;
    }

    .hero h1 {
      font-size: clamp(32px, 5vw, 54px);
      font-weight: 300;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: 20px;
    }

    .hero-sub {
      font-size: 17px;
      font-weight: 300;
      color: var(--dim);
      line-height: 1.6;
      max-width: 560px;
      margin: 0 auto 40px;
    }

    /* ── PROMISE BOX ────────────────────────── */
    .promise-box {
      background: var(--green-dim);
      border: 1px solid var(--green-border);
      border-radius: 12px;
      padding: 28px 36px;
      max-width: 540px;
      margin: 0 auto;
      text-align: left;
    }

    .promise-box .promise-label {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--green);
      margin-bottom: 12px;
    }

    .promise-box p {
      font-size: 15px;
      font-weight: 300;
      line-height: 1.7;
      color: var(--white);
    }

    .promise-box strong {
      font-weight: 500;
      color: var(--white);
    }

    /* ── SECTIONS ───────────────────────────── */
    .section {
      margin-bottom: 72px;
    }

    .section-label {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--green);
      margin-bottom: 12px;
    }

    .section h2 {
      font-size: 26px;
      font-weight: 300;
      letter-spacing: -0.02em;
      margin-bottom: 32px;
    }

    /* ── CHECK LIST ─────────────────────────── */
    .check-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .check-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      font-size: 15px;
      font-weight: 300;
      color: var(--dim);
      line-height: 1.5;
    }

    .ico-check {
      flex-shrink: 0;
      width: 22px;
      height: 22px;
      background: var(--green-dim);
      border: 1px solid var(--green-border);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      color: var(--green);
      margin-top: 1px;
    }

    .ico-cross {
      flex-shrink: 0;
      width: 22px;
      height: 22px;
      background: var(--red-dim);
      border: 1px solid var(--red-border);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      color: #ef4444;
      margin-top: 1px;
    }

    /* ── PERMISSION CARDS ───────────────────── */
    .perm-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    .perm-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 20px;
    }

    .perm-scope {
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      color: var(--green);
      margin-bottom: 10px;
      letter-spacing: 0.04em;
    }

    .perm-card p {
      font-size: 13px;
      font-weight: 300;
      color: var(--dimmer);
      line-height: 1.6;
    }

    .perm-note {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 18px 22px;
      font-size: 13px;
      font-weight: 300;
      color: var(--dimmer);
      line-height: 1.7;
    }

    /* ── INFRA GRID ─────────────────────────── */
    .infra-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .infra-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 22px;
    }

    .infra-label {
      font-family: 'DM Mono', monospace;
      font-size: 9px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--dimmer);
      margin-bottom: 8px;
    }

    .infra-title {
      font-size: 15px;
      font-weight: 400;
      color: var(--white);
      margin-bottom: 8px;
    }

    .infra-desc {
      font-size: 13px;
      font-weight: 300;
      color: var(--dimmer);
      line-height: 1.6;
    }

    /* ── DATA DELETION ──────────────────────── */
    .deletion-box {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 28px 32px;
    }

    .deletion-box p {
      font-size: 15px;
      font-weight: 300;
      color: var(--dim);
      line-height: 1.7;
    }

    /* ── CONTACT ────────────────────────────── */
    .contact-box {
      text-align: center;
    }

    .contact-box p {
      font-size: 16px;
      font-weight: 300;
      color: var(--dim);
      line-height: 1.7;
    }

    .contact-box a {
      color: var(--green);
      text-decoration: none;
    }

    .contact-box a:hover {
      text-decoration: underline;
    }

    /* ── FOOTER ─────────────────────────────── */
    footer {
      border-top: 1px solid var(--line);
      padding: 22px 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    footer span {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: var(--dimmer);
      letter-spacing: 0.06em;
    }

    .footer-links {
      display: flex;
      gap: 24px;
      align-items: center;
    }

    footer a {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: var(--dimmer);
      letter-spacing: 0.06em;
      text-decoration: none;
      transition: color 0.2s;
    }
    footer a:hover { color: var(--white); }

    /* ── RESPONSIVE ─────────────────────────── */
    @media (max-width: 768px) {
      header { padding: 14px 20px; }
      nav { gap: 20px; }
      main { padding: 100px 20px 60px; }
      .perm-cards { grid-template-columns: 1fr; }
      .infra-grid { grid-template-columns: 1fr; }
      footer { padding: 16px 20px; flex-direction: column; gap: 12px; text-align: center; }
      .promise-box { padding: 20px 22px; }
    }
  </style>
</head>
<body>

  <!-- ── HEADER ── -->
  <header>
    <a href="/">
      <img src="/W+L.png" alt="Grassion" style="height:28px;" onerror="this.style.display='none'" />
    </a>
    <nav>
      <a href="/about/">About</a>
      <a href="/pricing/">Pricing</a>
      <a href="/contact/">Contact</a>
      <a href={APP_URL} class="cta-btn">Sign in</a>
    </nav>
  </header>

  <main>

    <!-- ── SECTION 1: HERO ── -->
    <div class="hero">
      <div class="eyebrow">Security at Grassion</div>
      <h1>Built for<br />enterprise trust.</h1>
      <p class="hero-sub">
        Grassion analyzes engineering workflow metadata.
        We never read or store your source code.
      </p>

      <div class="promise-box">
        <div class="promise-label">Our commitment</div>
        <p>
          <strong>Grassion never reads your source code.</strong>
          We only read PR metadata visible in GitHub — titles, commit messages, and timestamps.
          No code is stored. Ever.
        </p>
      </div>
    </div>

    <!-- ── SECTION 2: WHAT WE ACCESS ── -->
    <div class="section">
      <div class="section-label">Data access</div>
      <h2>What Grassion reads</h2>
      <ul class="check-list">
        <li class="check-item"><span class="ico-check">✓</span><span>PR titles and descriptions</span></li>
        <li class="check-item"><span class="ico-check">✓</span><span>Commit message text (not diff or code)</span></li>
        <li class="check-item"><span class="ico-check">✓</span><span>Merge timestamps and dates</span></li>
        <li class="check-item"><span class="ico-check">✓</span><span>Author GitHub usernames (public data)</span></li>
        <li class="check-item"><span class="ico-check">✓</span><span>Review counts and approval status</span></li>
        <li class="check-item"><span class="ico-check">✓</span><span>PR open / close / merge events</span></li>
      </ul>
    </div>

    <!-- ── SECTION 3: WHAT WE NEVER TOUCH ── -->
    <div class="section">
      <div class="section-label">Off limits</div>
      <h2>What Grassion never touches</h2>
      <ul class="check-list">
        <li class="check-item"><span class="ico-cross">✗</span><span>Your source code or file contents</span></li>
        <li class="check-item"><span class="ico-cross">✗</span><span>Secrets, API keys, or environment variables</span></li>
        <li class="check-item"><span class="ico-cross">✗</span><span>Private keys or credentials of any kind</span></li>
        <li class="check-item"><span class="ico-cross">✗</span><span>Internal Slack or email communications</span></li>
        <li class="check-item"><span class="ico-cross">✗</span><span>Developer personal data beyond GitHub profile</span></li>
        <li class="check-item"><span class="ico-cross">✗</span><span>Code diffs or actual implementation details</span></li>
      </ul>
    </div>

    <!-- ── SECTION 4: GITHUB PERMISSIONS ── -->
    <div class="section">
      <div class="section-label">Permissions</div>
      <h2>Exact GitHub permissions we request</h2>
      <div class="perm-cards">
        <div class="perm-card">
          <div class="perm-scope">read:user</div>
          <p>Your GitHub username and public profile. Same as any GitHub OAuth app.</p>
        </div>
        <div class="perm-card">
          <div class="perm-scope">repo</div>
          <p>Read PR metadata, commit messages, and review outcomes. Cannot write, merge, or modify anything.</p>
        </div>
        <div class="perm-card">
          <div class="perm-scope">read:org</div>
          <p>Verify organisation membership. Cannot modify org settings or member permissions.</p>
        </div>
      </div>
      <div class="perm-note">
        These are read-only scopes enforced by GitHub, not just our policy.
        Grassion is <em>technically incapable</em> of modifying your repositories.
        The same scopes are used by Vercel, Netlify, Linear, and thousands of developer tools.
      </div>
    </div>

    <!-- ── SECTION 5: INFRASTRUCTURE ── -->
    <div class="section">
      <div class="section-label">Infrastructure</div>
      <h2>Where your data lives</h2>
      <div class="infra-grid">
        <div class="infra-card">
          <div class="infra-label">Database</div>
          <div class="infra-title">Supabase PostgreSQL</div>
          <div class="infra-desc">SOC2 Type II certified. Encrypted at rest with AES-256. Mumbai region.</div>
        </div>
        <div class="infra-card">
          <div class="infra-label">Hosting</div>
          <div class="infra-title">Fly.io</div>
          <div class="infra-desc">SOC2 compliant infrastructure. TLS encryption in transit. Zero-downtime deploys.</div>
        </div>
        <div class="infra-card">
          <div class="infra-label">Authentication</div>
          <div class="infra-title">GitHub OAuth only</div>
          <div class="infra-desc">No passwords stored anywhere. JWT tokens expire in 7 days. Sessions revocable from Settings.</div>
        </div>
        <div class="infra-card">
          <div class="infra-label">Payments</div>
          <div class="infra-title">Razorpay</div>
          <div class="infra-desc">PCI DSS compliant. We never see or store card details; payment data goes directly to Razorpay.</div>
        </div>
      </div>
    </div>

    <!-- ── SECTION 6: DATA DELETION ── -->
    <div class="section">
      <div class="section-label">Data retention</div>
      <h2>Your data, your control</h2>
      <div class="deletion-box">
        <p>
          Delete all your data at any time from <strong>Settings → Danger Zone</strong>.
          We permanently remove all records within 24 hours. No backups retained.
          You can also uninstall the GitHub App at any time to stop all data collection immediately.
        </p>
      </div>
    </div>

    <!-- ── SECTION 7: CONTACT ── -->
    <div class="section contact-box">
      <div class="section-label">Get in touch</div>
      <h2>Security questions?</h2>
      <p>
        Email us at <a href="mailto:info@grassion.com">info@grassion.com</a><br />
        We respond within 24 hours.
      </p>
    </div>

  </main>

  <!-- ── FOOTER ── -->
  <footer>
    <span>© {year} Grassion Intelligence</span>
    <nav class="footer-links">
      <a href="/security/">Security</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
  </footer>

</body>
</html>
