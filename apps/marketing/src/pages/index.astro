---
// Grassion Marketing Landing Page
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Grassion · Prove AI code had human review. Per PR. Forever.</title>
  <meta name="description" content="Grassion gives every PR a permanent accountability record: who wrote it, how much was AI-generated, who reviewed it, and what they checked. Audit-ready for SOC 2, SEBI and RBI. GitHub App, 5-minute setup." />
  <link rel="icon" type="image/png" href="/Grassion%20single%20logo%20(1).png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:ital,opsz,wght@0,9..40,200;0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
  <link rel="preconnect" href="https://grassion-api.fly.dev" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black: #000000;
      --white: #ffffff;
      --dim: rgba(255,255,255,0.72);
      --dimmer: rgba(255,255,255,0.44);
      --line: rgba(255,255,255,0.07);
      --green: #22c55e;
      --red: #ef4444;
      --amber: #f59e0b;
      --blue: #3b82f6;
    }

    html, body {
      background: var(--black);
      color: var(--white);
      font-family: 'DM Sans', sans-serif;
    }

    /* Subtle dot-grid texture */
    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image:
        radial-gradient(rgba(255,255,255,0.045) 1px, transparent 1px);
      background-size: 32px 32px;
      pointer-events: none;
      z-index: 0;
    }

    /* ── HEADER ─────────────────────────────── */
    header {
      position: fixed;
      top: 0; left: 0; right: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 52px;
      z-index: 100;
      border-bottom: 1px solid var(--line);
      background: rgba(0,0,0,0.88);
      backdrop-filter: blur(24px);
    }

    .logo-pill { display: flex; align-items: center; gap: 10px; }

    .github-app-tag {
      font-family: 'DM Mono', monospace;
      font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(255,255,255,0.28);
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 20px; padding: 2px 8px;
    }

    nav { display: flex; gap: 36px; align-items: center; }
    nav a {
      font-size: 11px; font-weight: 300; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--dimmer);
      text-decoration: none; transition: color 0.2s;
    }
    nav a:hover { color: var(--white); }
    nav a.signin-nav {
      color: var(--white);
      border: 1px solid rgba(255,255,255,0.18);
      padding: 7px 18px; border-radius: 5px; letter-spacing: 0.08em;
      transition: border-color 0.2s, background 0.2s;
    }
    nav a.signin-nav:hover { border-color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.05); }

    /* ── HERO GRID ───────────────────────────── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding-top: 71px;
      position: relative; z-index: 1;
    }

    /* ── LEFT ───────────────────────────────── */
    .left {
      display: flex; flex-direction: column; justify-content: center;
      padding: 0 56px;
      border-right: 1px solid var(--line);
    }

    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      margin-bottom: 28px;
    }
    .eyebrow-dot {
      width: 6px; height: 6px; background: var(--green);
      border-radius: 50%; box-shadow: 0 0 10px var(--green);
      animation: pulse 2.4s ease-in-out infinite;
    }
    @keyframes pulse {
      0%,100% { opacity: 1; transform: scale(1); }
      50%      { opacity: 0.4; transform: scale(0.7); }
    }
    .eyebrow-text {
      font-family: 'DM Mono', monospace; font-size: 10px;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(255,255,255,0.32);
    }

    h1 {
      font-size: clamp(32px, 3.5vw, 54px);
      font-weight: 200; line-height: 1.1; letter-spacing: -0.03em;
      margin-bottom: 10px;
    }
    h1 em { font-style: italic; font-weight: 200; color: rgba(255,255,255,0.55); }
    h1 strong { font-weight: 500; color: var(--white); }
    h1 .accent {
      font-weight: 500;
      background: linear-gradient(90deg, #fff 20%, rgba(34,197,94,0.85) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .h1-line2 {
      font-size: clamp(14px, 1.4vw, 20px);
      font-weight: 300;
      color: rgba(255,255,255,0.4);
      letter-spacing: -0.01em;
      margin-bottom: 28px;
      line-height: 1.4;
      max-width: 400px;
    }

    .sub {
      font-size: 14px; font-weight: 300;
      color: rgba(255,255,255,0.46);
      line-height: 1.85; max-width: 400px; margin-bottom: 32px;
    }

    /* feature bullets */
    .features { display: flex; flex-direction: column; gap: 11px; margin-bottom: 36px; }
    .feature-row { display: flex; align-items: flex-start; gap: 10px; }
    .feature-icon {
      width: 20px; height: 20px; border-radius: 5px;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;
    }
    .feature-icon.r { background: rgba(239,68,68,0.1); color: rgba(239,68,68,0.75); }
    .feature-icon.a { background: rgba(245,158,11,0.1); color: rgba(245,158,11,0.75); }
    .feature-icon.g { background: rgba(34,197,94,0.1); color: rgba(34,197,94,0.75); }
    .feature-row span { font-size: 12px; font-weight: 300; color: rgba(255,255,255,0.45); line-height: 1.5; }
    .feature-row strong { font-weight: 500; color: rgba(255,255,255,0.75); }

    /* CTA */
    .cta-row { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
    .github-btn {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--white); color: var(--black);
      text-decoration: none; font-family: 'DM Mono', monospace;
      font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 14px 26px; border-radius: 4px;
      transition: opacity 0.18s, transform 0.18s, box-shadow 0.18s;
      white-space: nowrap; box-shadow: 0 4px 24px rgba(255,255,255,0.08);
    }
    .github-btn:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 8px 32px rgba(255,255,255,0.12); }
    .github-btn svg { flex-shrink: 0; }
    .cta-meta {
      font-family: 'DM Mono', monospace; font-size: 10px;
      color: rgba(255,255,255,0.26); letter-spacing: 0.06em; line-height: 1.6;
    }

    /* ── RIGHT PANEL ────────────────────────── */
    .right {
      position: relative;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      overflow: hidden;
      padding: 71px 32px 0;
      gap: 0;
    }

    /* green radial glow behind cube */
    .right::before {
      content: ''; position: absolute;
      width: 440px; height: 440px; border-radius: 50%;
      background: radial-gradient(circle, rgba(34,197,94,0.06) 0%, transparent 68%);
      pointer-events: none; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
    }

    /* dashboard mockup wrapper — takes up full available height */
    .dashboard {
      flex: 1;
      width: 100%;
      max-width: 520px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 28px 0 0;
      position: relative;
      z-index: 1;
    }

    /* top row: 2 metric cards side by side */
    .dash-row { display: flex; gap: 10px; }

    .dash-card {
      flex: 1;
      background: rgba(10,10,10,0.95);
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 10px;
      padding: 16px 18px;
      font-family: 'DM Mono', monospace;
      backdrop-filter: blur(16px);
      animation: fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) both;
      box-shadow: 0 4px 24px rgba(0,0,0,0.5);
    }

    .dash-card:nth-child(1) { animation-delay: 0.2s; }
    .dash-card:nth-child(2) { animation-delay: 0.35s; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .example-badge {
      display: inline-block; font-size: 7px; letter-spacing: 0.14em;
      text-transform: uppercase; color: rgba(255,255,255,0.18);
      border: 1px solid rgba(255,255,255,0.08); border-radius: 3px;
      padding: 1px 5px; margin-bottom: 8px;
    }

    .card-label {
      font-size: 8px; letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(255,255,255,0.26); margin-bottom: 6px;
    }

    .card-value {
      font-size: 28px; font-weight: 500; letter-spacing: -0.03em;
      line-height: 1; margin-bottom: 5px;
    }

    .card-sub { font-size: 10px; color: rgba(255,255,255,0.3); letter-spacing: 0.04em; }
    .card-sub.up   { color: var(--red); }
    .card-sub.down { color: var(--green); }

    /* coverage bar */
    .cov-bars { margin-top: 10px; display: flex; flex-direction: column; gap: 5px; }
    .cbar-row { display: flex; align-items: center; gap: 7px; }
    .cbar-label { font-size: 8px; color: rgba(255,255,255,0.28); letter-spacing: 0.06em; width: 36px; flex-shrink: 0; }
    .cbar-track { flex: 1; height: 3px; background: rgba(255,255,255,0.05); border-radius: 2px; overflow: hidden; }
    .cbar-fill { height: 100%; border-radius: 2px; }
    .cbar-fill.g { background: var(--green); }
    .cbar-fill.a { background: var(--amber); }
    .cbar-fill.r { background: var(--red); }
    .cbar-pct { font-size: 8px; color: rgba(255,255,255,0.28); width: 24px; text-align: right; }

    /* knowledge map card */
    .map-card {
      background: rgba(10,10,10,0.95);
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 10px;
      padding: 16px 18px;
      font-family: 'DM Mono', monospace;
      animation: fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) 0.5s both;
      box-shadow: 0 4px 24px rgba(0,0,0,0.5);
    }

    .map-grid {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 4px;
      margin-top: 10px;
    }

    .map-cell {
      aspect-ratio: 1;
      border-radius: 3px;
    }

    /* AI ROI card */
    .roi-card {
      background: rgba(10,10,10,0.95);
      border: 1px solid rgba(59,130,246,0.2);
      border-radius: 10px;
      padding: 16px 18px;
      font-family: 'DM Mono', monospace;
      animation: fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) 0.65s both;
      box-shadow: 0 4px 24px rgba(0,0,0,0.5);
      display: flex; align-items: center; gap: 14px;
    }

    .roi-icon {
      width: 32px; height: 32px; border-radius: 8px;
      background: rgba(59,130,246,0.1);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; color: var(--blue);
    }

    .roi-text {}
    .roi-label { font-size: 8px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.26); margin-bottom: 5px; }
    .roi-value { font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.75); letter-spacing: 0.01em; }
    .roi-sub { font-size: 10px; color: rgba(59,130,246,0.65); letter-spacing: 0.04em; margin-top: 3px; }

    /* ── STATS ──────────────────────────────── */
    .stats {
      display: flex; border-top: 1px solid var(--line);
      width: 100%; margin-top: auto; position: relative; z-index: 1;
    }

    .stat {
      flex: 1; padding: 20px 0; text-align: center;
      border-right: 1px solid var(--line);
      opacity: 0; transform: translateY(10px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .stat:last-child { border-right: none; }
    .stat-num {
      font-family: 'DM Mono', monospace; font-size: 20px; font-weight: 400;
      color: var(--white); display: block; margin-bottom: 5px; letter-spacing: -0.02em;
    }
    .stat-label {
      font-size: 9px; font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase;
      color: rgba(255,255,255,0.28); line-height: 1.4;
    }

    /* ── HOW IT WORKS ───────────────────────── */
    .how {
      position: relative; z-index: 1;
      border-top: 1px solid var(--line);
      padding: 80px 52px;
    }
    .how-eyebrow {
      font-family: 'DM Mono', monospace; font-size: 9px;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(255,255,255,0.26); margin-bottom: 48px; text-align: center;
    }
    .how-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 2px; max-width: 920px; margin: 0 auto 64px;
    }
    .how-step {
      border: 1px solid var(--line); padding: 32px 28px;
      background: rgba(255,255,255,0.01); transition: background 0.2s;
    }
    .how-step:hover { background: rgba(255,255,255,0.02); }
    .how-num {
      font-family: 'DM Mono', monospace; font-size: 10px;
      color: rgba(255,255,255,0.15); letter-spacing: 0.14em; margin-bottom: 20px;
    }
    .how-icon {
      width: 36px; height: 36px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center; margin-bottom: 16px;
    }
    .how-icon.g { background: rgba(34,197,94,0.1); color: var(--green); }
    .how-icon.r { background: rgba(239,68,68,0.1); color: var(--red); }
    .how-icon.b { background: rgba(59,130,246,0.1); color: var(--blue); }
    .how-title { font-size: 15px; font-weight: 400; color: var(--white); margin-bottom: 10px; letter-spacing: -0.01em; }
    .how-desc { font-size: 12px; font-weight: 300; color: rgba(255,255,255,0.38); line-height: 1.75; }

    .privacy-strip {
      max-width: 920px; margin: 0 auto;
      border: 1px solid var(--line); padding: 24px 32px;
      display: flex; align-items: center; gap: 20px;
    }
    .privacy-icon {
      width: 32px; height: 32px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.09);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; color: rgba(255,255,255,0.35);
    }
    .privacy-text { font-size: 12px; font-weight: 300; color: rgba(255,255,255,0.38); line-height: 1.65; }
    .privacy-text strong { font-weight: 500; color: rgba(255,255,255,0.6); }

    /* ── STICKY GRAPH SECTION ───────────────── */
    .sticky-section {
      position: relative; z-index: 1;
      border-top: 1px solid var(--line);
      padding: 80px 52px;
    }
    .sticky-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 48px; max-width: 920px; margin: 0 auto;
      align-items: center;
    }
    .sticky-h2 {
      font-size: clamp(22px, 2.2vw, 32px); font-weight: 200;
      line-height: 1.2; letter-spacing: -0.02em; color: var(--white);
      margin-bottom: 20px;
    }
    .sticky-desc {
      font-size: 13px; font-weight: 300; color: rgba(255,255,255,0.4);
      line-height: 1.8; margin-bottom: 32px;
    }
    .sticky-timeline { display: flex; flex-direction: column; gap: 16px; }
    .sticky-trow { display: flex; gap: 12px; align-items: flex-start; }
    .sticky-mo {
      font-family: 'DM Mono', monospace; font-size: 9px; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--green); flex-shrink: 0; padding-top: 1px; min-width: 52px;
    }
    .sticky-tdash { color: rgba(255,255,255,0.1); flex-shrink: 0; }
    .sticky-tdesc { font-size: 12px; font-weight: 300; color: rgba(255,255,255,0.38); line-height: 1.6; }
    .sticky-visual {
      background: rgba(10,10,10,0.95); border: 1px solid rgba(255,255,255,0.09);
      border-radius: 10px; padding: 24px 20px;
      font-family: 'DM Mono', monospace;
    }
    .sv-label { font-size: 8px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.26); margin-bottom: 20px; }
    .sv-bars { display: flex; flex-direction: column; gap: 10px; }
    .sv-bar-row { display: flex; align-items: center; gap: 10px; }
    .sv-mo { font-size: 8px; color: rgba(255,255,255,0.28); width: 24px; flex-shrink: 0; }
    .sv-track { flex: 1; height: 6px; background: rgba(255,255,255,0.04); border-radius: 3px; overflow: hidden; }
    .sv-fill { height: 100%; border-radius: 3px; transition: width 1s ease; }
    .sv-sub { font-size: 9px; color: rgba(255,255,255,0.18); margin-top: 16px; letter-spacing: 0.06em; }
    @media (max-width: 767px) {
      .sticky-section { padding: 56px 24px; }
      .sticky-grid { grid-template-columns: 1fr; gap: 32px; }
    }

    /* ── FOOTER ─────────────────────────────── */
    footer {
      position: relative; z-index: 1;
      padding: 20px 52px; display: flex; align-items: center; justify-content: space-between;
      border-top: 1px solid var(--line);
    }
    footer span, footer a {
      font-family: 'DM Mono', monospace; font-size: 10px;
      color: rgba(255,255,255,0.2); letter-spacing: 0.08em; text-decoration: none;
    }
    footer a:hover { color: rgba(255,255,255,0.45); }
    .footer-links { display: flex; gap: 24px; align-items: center; }

    /* ── ASK WIDGET ─────────────────────────── */
    .ask-btn {
      position: fixed; bottom: 28px; right: 28px;
      width: 44px; height: 44px; background: var(--white); color: var(--black);
      border: none; border-radius: 50%; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      z-index: 200; transition: transform 0.18s, box-shadow 0.18s;
      box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }
    .ask-btn:hover { transform: scale(1.08); box-shadow: 0 0 0 8px rgba(255,255,255,0.05), 0 4px 20px rgba(0,0,0,0.5); }
    .ask-btn svg { width: 17px; height: 17px; }

    .ask-panel {
      position: fixed; bottom: 84px; right: 28px; width: 290px;
      background: #060606; border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px; overflow: hidden; z-index: 200;
      transform: scale(0.9) translateY(12px); opacity: 0; pointer-events: none;
      transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1), opacity 0.18s ease;
      transform-origin: bottom right; box-shadow: 0 16px 48px rgba(0,0,0,0.6);
    }
    .ask-panel.open { transform: scale(1) translateY(0); opacity: 1; pointer-events: all; }
    .ask-header { padding: 13px 16px; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 9px; }
    .ask-dot { width: 6px; height: 6px; background: var(--white); border-radius: 50%; animation: pulse 2s ease-in-out infinite; }
    .ask-title { font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.1em; color: var(--white); }
    .ask-body { padding: 13px 16px; }
    .ask-body p { font-size: 12px; font-weight: 300; color: rgba(255,255,255,0.46); line-height: 1.6; margin-bottom: 12px; }
    .ask-form { display: flex; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; }
    .ask-form input { flex: 1; background: transparent; border: none; outline: none; color: var(--white); font-family: 'DM Mono', monospace; font-size: 11px; padding: 10px 12px; }
    .ask-form input::placeholder { color: rgba(255,255,255,0.14); }
    .ask-form button { background: var(--white); color: var(--black); border: none; cursor: pointer; font-family: 'DM Mono', monospace; font-size: 10px; font-weight: 500; letter-spacing: 0.1em; padding: 10px 14px; transition: opacity 0.18s; }
    .ask-form button:hover { opacity: 0.82; }

    /* ── MOBILE ─────────────────────────────── */
    @media (max-width: 767px) {
      header { padding: 14px 20px; }
      nav { gap: 16px; }
      nav a:not(.signin-nav) { display: none; }
      .github-app-tag { display: none; }
      .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 60px; }
      .left { padding: 44px 24px 48px; border-right: none; border-bottom: 1px solid var(--line); }
      h1 { font-size: clamp(28px, 9vw, 42px); }
      .h1-line2 { font-size: 13px; }
      .sub { font-size: 13px; }
      .right { padding: 36px 24px 0; min-height: 480px; justify-content: flex-start; }
      .dashboard { max-width: 100%; padding-top: 0; }
      .dash-row { flex-direction: column; }
      .how { padding: 56px 24px; }
      .how-grid { grid-template-columns: 1fr; }
      .privacy-strip { flex-direction: column; align-items: flex-start; }
      footer { padding: 14px 20px; }
      .footer-links { gap: 16px; }
      .ask-btn { bottom: 20px; right: 16px; }
      .ask-panel { right: 16px; width: calc(100vw - 32px); bottom: 76px; }
    }
  </style>
</head>
<body>

  <header>
    <div class="logo-pill">
      <a href="/"><img src="/W+L.png" alt="Grassion" style="height:27px;" /></a>
      <span class="github-app-tag">GitHub App</span>
    </div>
    <nav>
      <a href="/about/">About</a>
      <a href="/pricing/">Pricing</a>
      <a href="/contact/">Contact</a>
      <a class="signin-nav" href="https://grassion-api.fly.dev/auth/github">Sign in</a>
    </nav>
  </header>

  <section class="hero">

    <!-- LEFT -->
    <div class="left">

      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        <span class="eyebrow-text">AI Code Accountability · Compliance</span>
      </div>

      <h1>
        AI writes your code.<br>
