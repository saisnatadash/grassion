---
// Grassion Marketing Landing Page
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Grassion · Know your key-person risk before someone leaves</title>
  <meta name="description" content="Grassion shows which parts of your codebase only one person understands, and what happens when they leave. GitHub App, 5-minute setup. No code stored." />
  <link rel="icon" type="image/png" href="/Grassion%20single%20logo%20(1).png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:ital,opsz,wght@0,9..40,200;0,9..40,300;0,9..40,400;1,9..40,300&display=swap" rel="stylesheet" />
  <link rel="preconnect" href="https://grassion-api.fly.dev" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black: #000000;
      --white: #ffffff;
      --dim: rgba(255,255,255,0.72);
      --dimmer: rgba(255,255,255,0.44);
      --line: rgba(255,255,255,0.08);
      --green: #22c55e;
      --red: #ef4444;
      --yellow: #eab308;
    }

    html, body {
      height: 100%;
      overflow: hidden;
      background: var(--black);
      color: var(--white);
      font-family: 'DM Sans', sans-serif;
    }

    /* ── HEADER ─────────────────────────────── */
    header {
      position: fixed;
      top: 0; left: 0; right: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 52px;
      z-index: 100;
      border-bottom: 1px solid var(--line);
      background: rgba(0,0,0,0.8);
      backdrop-filter: blur(20px);
    }

    nav { display: flex; gap: 36px; align-items: center; }

    nav a {
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--dimmer);
      text-decoration: none;
      transition: color 0.2s;
    }

    nav a:hover { color: var(--white); }

    nav a.signin-nav {
      color: var(--white);
      border: 1px solid rgba(255,255,255,0.2);
      padding: 7px 18px;
      border-radius: 5px;
      letter-spacing: 0.08em;
      transition: border-color 0.2s, background 0.2s;
    }

    nav a.signin-nav:hover {
      border-color: rgba(255,255,255,0.5);
      background: rgba(255,255,255,0.06);
    }

    /* ── MAIN GRID ──────────────────────────── */
    main {
      height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding-top: 71px;
    }

    /* ── LEFT PANEL ─────────────────────────── */
    .left {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0 56px;
      border-right: 1px solid var(--line);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 32px;
    }

    .eyebrow-dot {
      width: 6px; height: 6px;
      background: var(--green);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--green);
      animation: pulse 2.4s ease-in-out infinite;
    }

    @keyframes pulse {
      0%,100% { opacity: 1; transform: scale(1); }
      50%      { opacity: 0.4; transform: scale(0.7); }
    }

    .eyebrow-text {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.38);
    }

    h1 {
      font-size: clamp(32px, 3.4vw, 52px);
      font-weight: 200;
      line-height: 1.12;
      letter-spacing: -0.03em;
      margin-bottom: 24px;
    }

    h1 strong {
      font-weight: 400;
      color: var(--white);
    }

    h1 em {
      font-style: italic;
      font-weight: 200;
      color: rgba(255,255,255,0.7);
    }

    .sub {
      font-size: 14px;
      font-weight: 300;
      color: rgba(255,255,255,0.55);
      line-height: 1.8;
      max-width: 420px;
      margin-top: 28px;
      margin-bottom: 28px;
    }

    /* ── PROOF POINTS ───────────────────────── */
    .proof {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 40px;
    }

    .proof-item {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .proof-icon {
      width: 28px; height: 28px;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: rgba(255,255,255,0.5);
    }

    .proof-text {
      font-size: 13px;
      font-weight: 300;
      color: rgba(255,255,255,0.6);
      line-height: 1.5;
    }

    .proof-text strong {
      font-weight: 400;
      color: rgba(255,255,255,0.9);
    }

    /* ── CTA ────────────────────────────────── */
    .cta-row {
      display: flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .github-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--white);
      color: var(--black);
      text-decoration: none;
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 14px 26px;
      border-radius: 4px;
      transition: opacity 0.18s, transform 0.18s;
      white-space: nowrap;
    }

    .github-btn:hover { opacity: 0.88; transform: translateY(-1px); }
    .github-btn svg { flex-shrink: 0; }

    .cta-meta {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: rgba(255,255,255,0.3);
      letter-spacing: 0.06em;
      line-height: 1.6;
    }

    /* ── RIGHT PANEL ────────────────────────── */
    .right {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      gap: 0;
    }

    /* Subtle radial glow behind the feed */
    .right::before {
      content: '';
      position: absolute;
      width: 480px; height: 480px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(34,197,94,0.04) 0%, transparent 70%);
      pointer-events: none;
    }

    /* ── CUBE SCENE ─────────────────────────── */
    .scene-wrap {
      position: relative;
      width: 360px;
      height: 360px;
      flex-shrink: 0;
    }

    .scene {
      position: relative;
      width: 360px; height: 360px;
      perspective: 1100px;
    }

    .ring {
      position: absolute; inset: 0;
      border-radius: 50%; border: 1px solid rgba(255,255,255,0.1);
      transform-style: preserve-3d;
      animation: spinRing 20s linear infinite;
    }

    .ring::after {
      content: ''; position: absolute;
      top: 50%; left: -5px; width: 10px; height: 10px;
      background: var(--white); border-radius: 50%;
      transform: translateY(-50%);
      box-shadow: 0 0 16px 4px rgba(255,255,255,0.28);
    }

    .ring-2 { inset: 50px; border-color: rgba(255,255,255,0.06); animation: spinRing 13s linear infinite reverse; }
    .ring-3 { inset: 100px; border-color: rgba(255,255,255,0.04); animation: spinRing 8s linear infinite; }

    @keyframes spinRing {
      from { transform: rotateX(70deg) rotateZ(0deg); }
      to   { transform: rotateX(70deg) rotateZ(360deg); }
    }

    .cube-wrap { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }

    .cube {
      width: 90px; height: 90px;
      position: relative; transform-style: preserve-3d;
      animation: spinCube 11s ease-in-out infinite;
    }

    @keyframes spinCube {
      0%   { transform: rotateX(12deg) rotateY(0deg); }
      25%  { transform: rotateX(12deg) rotateY(90deg); }
      50%  { transform: rotateX(12deg) rotateY(180deg); }
      75%  { transform: rotateX(12deg) rotateY(270deg); }
      100% { transform: rotateX(12deg) rotateY(360deg); }
    }

    .face {
      position: absolute; width: 90px; height: 90px;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.03);
      display: flex; align-items: center; justify-content: center;
      font-family: 'DM Mono', monospace; font-size: 9px;
      font-weight: 500; letter-spacing: 0.18em; color: rgba(255,255,255,0.38);
    }

    .face-front  { transform: translateZ(45px); }
    .face-back   { transform: rotateY(180deg) translateZ(45px); }
    .face-left   { transform: rotateY(-90deg) translateZ(45px); }
    .face-right  { transform: rotateY(90deg) translateZ(45px); }
    .face-top    { transform: rotateX(90deg) translateZ(45px); }
    .face-bottom { transform: rotateX(-90deg) translateZ(45px); }

    /* ── FLOATING CARDS ─────────────────────── */
    .verdict-card {
      position: absolute;
      top: 24px; right: -8px;
      background: rgba(10,10,10,0.9);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 8px;
      padding: 10px 16px;
      font-family: 'DM Mono', monospace;
      z-index: 10;
      backdrop-filter: blur(12px);
    }

    .verdict-label {
      font-size: 8px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.3);
      margin-bottom: 4px;
    }

    .verdict-value {
      font-size: 13px;
      font-weight: 500;
      color: var(--white);
      letter-spacing: 0.03em;
    }

    .waste-card {
      position: absolute;
      bottom: 24px; left: -8px;
      background: rgba(10,10,10,0.9);
      border: 1px solid rgba(239,68,68,0.2);
      border-radius: 8px;
      padding: 10px 16px;
      font-family: 'DM Mono', monospace;
      z-index: 10;
      backdrop-filter: blur(12px);
    }

    .waste-label {
      font-size: 8px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.3);
      margin-bottom: 4px;
    }

    .waste-value {
      font-size: 13px;
      font-weight: 500;
      color: rgba(239,68,68,0.9);
      letter-spacing: 0.03em;
    }


    /* ── STATS ──────────────────────────────── */
    .stats {
      display: flex;
      border-top: 1px solid var(--line);
      width: 100%;
      margin-top: auto;
    }

    .stat {
      flex: 1;
      padding: 18px 0;
      text-align: center;
      border-right: 1px solid var(--line);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.45s ease, transform 0.45s ease;
    }

    .stat:last-child { border-right: none; }

    .stat-num {
      font-family: 'DM Mono', monospace;
      font-size: 20px;
      font-weight: 400;
      color: var(--white);
      display: block;
      margin-bottom: 4px;
    }

    .stat-label {
      font-size: 9px;
      font-weight: 300;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.35);
    }

    /* ── FOOTER ─────────────────────────────── */
    footer {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      padding: 13px 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--line);
      background: rgba(0,0,0,0.65);
      backdrop-filter: blur(12px);
    }

    footer span, footer a {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: rgba(255,255,255,0.28);
      letter-spacing: 0.08em;
      text-decoration: none;
    }

    footer a:hover { color: rgba(255,255,255,0.5); }
    .footer-links { display: flex; gap: 20px; align-items: center; }

    /* ── ASK WIDGET ─────────────────────────── */
    .ask-btn {
      position: fixed;
      bottom: 54px; right: 28px;
      width: 44px; height: 44px;
      background: var(--white);
      color: var(--black);
      border: none;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 200;
      transition: transform 0.18s, box-shadow 0.18s;
    }

    .ask-btn:hover {
      transform: scale(1.08);
      box-shadow: 0 0 0 8px rgba(255,255,255,0.05);
    }

    .ask-btn svg { width: 17px; height: 17px; }

    .ask-panel {
      position: fixed;
      bottom: 110px; right: 28px;
      width: 290px;
      background: #080808;
      border: 1px solid rgba(255,255,255,0.11);
      border-radius: 10px;
      overflow: hidden;
      z-index: 200;
      transform: scale(0.9) translateY(12px);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1), opacity 0.18s ease;
      transform-origin: bottom right;
    }

    .ask-panel.open {
      transform: scale(1) translateY(0);
      opacity: 1;
      pointer-events: all;
    }

    .ask-header {
      padding: 13px 16px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .ask-dot {
      width: 6px; height: 6px;
      background: var(--white);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    .ask-title {
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.1em;
      color: var(--white);
    }

    .ask-body { padding: 13px 16px; }

    .ask-body p {
      font-size: 12px;
      font-weight: 300;
      color: rgba(255,255,255,0.55);
      line-height: 1.6;
      margin-bottom: 12px;
    }

    .ask-form {
      display: flex;
      border: 1px solid var(--line);
      border-radius: 4px;
      overflow: hidden;
    }

    .ask-form input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: var(--white);
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      padding: 10px 12px;
    }

    .ask-form input::placeholder { color: rgba(255,255,255,0.18); }

    .ask-form button {
      background: var(--white);
      color: var(--black);
      border: none;
      cursor: pointer;
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.1em;
      padding: 10px 14px;
      transition: opacity 0.18s;
    }

    .ask-form button:hover { opacity: 0.82; }

    /* ── MOBILE ─────────────────────────────── */
    @media (max-width: 767px) {
      html, body { height: auto; overflow: auto; }

      header { padding: 14px 20px; }
      nav { gap: 16px; }
      nav a:not(.signin-nav) { display: none; }

      main {
        grid-template-columns: 1fr;
        height: auto;
        padding-top: 60px;
        padding-bottom: 54px;
      }

      .left {
        padding: 40px 24px 44px;
        border-right: none;
        border-bottom: 1px solid var(--line);
      }

      h1 { font-size: clamp(28px, 9vw, 40px); }
      .sub { font-size: 13px; margin-bottom: 28px; }
      .proof { margin-bottom: 28px; }

      .right {
        padding: 40px 24px 0;
        align-items: center;
      }

      .scene-wrap { transform: scale(0.78); transform-origin: top center; margin-bottom: -60px; }

      .stats { margin-top: 24px; }
      .stat { padding: 16px 0; }

      footer {
        padding: 11px 20px;
        position: static;
      }

      .ask-btn { bottom: 18px; right: 16px; }
      .ask-panel { right: 16px; width: calc(100vw - 32px); bottom: 72px; }
    }
  </style>
</head>
<body>

  <header>
    <a href="/"><img src="/W+L.png" alt="Grassion" style="height:27px;" /></a>
    <nav>
      <a href="/about/">About</a>
      <a href="/pricing/">Pricing</a>
      <a href="/contact/">Contact</a>
      <a class="signin-nav" href="https://grassion-api.fly.dev/auth/github">Sign in</a>
    </nav>
  </header>

  <main>

    <!-- ── LEFT: COPY ── -->
    <div class="left">

      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        <span class="eyebrow-text">Knowledge Risk · Continuity</span>
      </div>

      <h1>
        If your best engineer<br>
        <em>quit tomorrow,</em><br>
        <strong>what breaks?</strong>
      </h1>

      <div class="cta-row">
        <a class="github-btn" href="https://grassion-api.fly.dev/auth/github?force=true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          See your key-person risk free
        </a>
        <div class="cta-meta">
          14-day free trial<br>
          No credit card · 5 min setup
        </div>
      </div>

      <p class="sub">
        Grassion shows which parts of your codebase only one person understands, and what happens when they leave. We never store your code.
      </p>

      <div class="proof">
        <div class="proof-item">
          <div class="proof-icon">01</div>
          <div class="proof-text">
            <strong>Departure Impact:</strong> pick any engineer, see exactly which critical areas only they can maintain
          </div>
        </div>
        <div class="proof-item">
          <div class="proof-icon">02</div>
          <div class="proof-text">
            <strong>PR warnings:</strong> every PR touching a single-owner area gets a reviewer suggestion, automatically
          </div>
        </div>
        <div class="proof-item">
          <div class="proof-icon">03</div>
          <div class="proof-text">
            <strong>Continuity trend:</strong> track your Key-Person Exposure % weekly and drive it down over time
          </div>
        </div>
      </div>

    </div>

    <!-- ── RIGHT: CUBE ANIMATION ── -->
    <div class="right">

      <div class="scene-wrap">
        <div class="verdict-card">
          <div class="verdict-label">Key-person exposure</div>
          <div class="verdict-value">34% at risk · trending down</div>
        </div>
        <div class="scene">
          <div class="ring"></div>
          <div class="ring ring-2"></div>
          <div class="ring ring-3"></div>
          <div class="cube-wrap">
            <div class="cube">
              <div class="face face-front">RISK</div>
              <div class="face face-back">KNOW</div>
              <div class="face face-left">WHO</div>
              <div class="face face-right">STAY</div>
              <div class="face face-top"></div>
              <div class="face face-bottom"></div>
            </div>
          </div>
        </div>
        <div class="waste-card">
          <div class="waste-label">If Priya leaves</div>
          <div class="waste-value">12 areas · no backup owner</div>
        </div>
      </div>

      <!-- Stats row -->
      <div class="stats">
        <div class="stat" id="s1"><span class="stat-num">1 in 3</span><span class="stat-label">Critical areas have one owner</span></div>
        <div class="stat" id="s2"><span class="stat-num">12 wks</span><span class="stat-label">Avg knowledge gap recovery</span></div>
        <div class="stat" id="s3"><span class="stat-num">5 min</span><span class="stat-label">To first risk report</span></div>
      </div>

    </div>

  </main>

  <footer>
    <span>© 2026 Grassion Intelligence</span>
    <nav class="footer-links">
      <a href="/security/">Security</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
  </footer>

  <!-- ASK WIDGET -->
  <button class="ask-btn" id="askToggle" title="Ask us anything">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="ask-panel" id="askPanel">
    <div class="ask-header">
      <div class="ask-dot"></div>
      <span class="ask-title">Ask us anything</span>
    </div>
    <div class="ask-body">
      <p>Question about Grassion or want a demo? We reply personally.</p>
      <div class="ask-form">
        <input type="text" id="askInput" placeholder="Type your question..." />
        <button id="askSend">Send</button>
      </div>
    </div>
  </div>

  <script is:inline>
    /* ── ASK WIDGET ── */
    var panel = document.getElementById('askPanel');
    var toggle = document.getElementById('askToggle');
    toggle.addEventListener('click', function() { panel.classList.toggle('open'); });
    document.addEventListener('click', function(e) {
      if (!panel.contains(e.target) && !toggle.contains(e.target)) panel.classList.remove('open');
    });
    document.getElementById('askSend').addEventListener('click', function() {
      var q = document.getElementById('askInput').value.trim();
      if (!q) return;
      window.location.href = 'mailto:info@grassion.com?subject=Question via grassion.com&body=' + encodeURIComponent(q);
    });
    document.getElementById('askInput').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') document.getElementById('askSend').click();
    });

    /* ── STATS ENTRANCE ── */
    window.addEventListener('load', function() {
      ['s1','s2','s3'].forEach(function(id, i) {
        setTimeout(function() {
          var el = document.getElementById(id);
          if (el) { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; }
        }, 600 + i * 160);
      });
    });

    /* ── WARM UP FLY.IO API ── */
    fetch('https://grassion-api.fly.dev/health', { mode: 'no-cors' }).catch(function(){});

    /* ── FIRST-PARTY ANALYTICS ── */
    (function(){
      var API = 'https://grassion-api.fly.dev';
      var SID_KEY = 'g_sid';
      function getSid(){try{var s=sessionStorage.getItem(SID_KEY);if(s)return s}catch(_){}var id=Math.random().toString(36).slice(2)+Math.random().toString(36).slice(2);try{sessionStorage.setItem(SID_KEY,id)}catch(_){}return id}
      var sid=getSid();
      function track(name,meta){try{var payload=JSON.stringify({events:[{session_id:sid,event_name:name,source:'marketing',page:location.pathname,referrer:document.referrer||'',metadata:meta||{}}]});if(navigator.sendBeacon){navigator.sendBeacon(API+'/api/track',new Blob([payload],{type:'application/json'}))}else{fetch(API+'/api/track',{method:'POST',headers:{'Content-Type':'application/json'},body:payload,keepalive:true}).catch(function(){})}}catch(_){}}
      track('page_view',{title:document.title});
      document.addEventListener('click',function(e){var el=e.target.closest('a,button');if(!el)return;var label=el.getAttribute('data-track')||el.innerText.trim().slice(0,60);track('click',{label:label,tag:el.tagName.toLowerCase()})});
      var askInput=document.getElementById('askInput');
      if(askInput){askInput.closest('form')||askInput.addEventListener('keydown',function(e){if(e.key==='Enter'){track('demo_question',{q:askInput.value.trim().slice(0,100)})}})}
      window._gtrack=track;
    })();

    /* ── REFERRAL TRACKING ── */
    (function() {
      var params = new URLSearchParams(window.location.search);
      var urlRef = params.get('ref');
      if (urlRef) {
        document.cookie = 'grassion_ref=' + encodeURIComponent(urlRef) +
          ';max-age=' + (30 * 24 * 60 * 60) + ';path=/;SameSite=Lax';
      }
      var m = document.cookie.match(/(?:^|;\s*)grassion_ref=([^;]+)/);
      var ref = m ? decodeURIComponent(m[1]) : null;
      if (!ref) return;
      document.querySelectorAll('a[href*="auth/github"]').forEach(function(a) {
        var u = new URL(a.getAttribute('href'), window.location.href);
        u.searchParams.set('ref', ref);
        a.setAttribute('href', u.toString());
      });
    })();
  </script>

</body>
</html>
