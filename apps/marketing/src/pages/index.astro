  <script is:inline>
    /* ── KNOWLEDGE MAP HEATMAP ── */
    var colors = [
      'rgba(34,197,94,0.7)','rgba(34,197,94,0.5)','rgba(34,197,94,0.35)',
      'rgba(245,158,11,0.6)','rgba(245,158,11,0.4)',
      'rgba(239,68,68,0.6)','rgba(239,68,68,0.4)',
      'rgba(255,255,255,0.05)'
    ];
    var weights = [8,6,5,4,3,3,2,10];
    var pool = [];
    colors.forEach(function(c,i){ for(var j=0;j<weights[i];j++) pool.push(c); });
    var grid = document.getElementById('mapGrid');
    if(grid) {
      for(var i=0;i<40;i++){
        var cell = document.createElement('div');
        cell.className = 'map-cell';
        cell.style.background = pool[Math.floor(Math.random()*pool.length)];
        grid.appendChild(cell);
      }
    }

    /* ── ASK WIDGET ── */
    var panel=document.getElementById('askPanel'),toggle=document.getElementById('askToggle');
    toggle.addEventListener('click',function(){panel.classList.toggle('open');});
    document.addEventListener('click',function(e){if(!panel.contains(e.target)&&!toggle.contains(e.target))panel.classList.remove('open');});
    document.getElementById('askSend').addEventListener('click',function(){
      var q=document.getElementById('askInput').value.trim();
      if(!q)return;
      window.location.href='mailto:info@grassion.com?subject=Question via grassion.com&body='+encodeURIComponent(q);
    });
    document.getElementById('askInput').addEventListener('keydown',function(e){if(e.key==='Enter')document.getElementById('askSend').click();});

    /* ── STATS ENTRANCE ── */
    window.addEventListener('load',function(){
      ['s1','s2','s3'].forEach(function(id,i){
        setTimeout(function(){var el=document.getElementById(id);if(el){el.style.opacity='1';el.style.transform='translateY(0)';}},500+i*140);
      });
    });

    /* ── WARM UP API ── */
    fetch('https://grassion-api.fly.dev/health',{mode:'no-cors'}).catch(function(){});

    /* ── ANALYTICS ── */
    (function(){
      var API='https://grassion-api.fly.dev',SID_KEY='g_sid';
      function getSid(){try{var s=sessionStorage.getItem(SID_KEY);if(s)return s}catch(_){}var id=Math.random().toString(36).slice(2)+Math.random().toString(36).slice(2);try{sessionStorage.setItem(SID_KEY,id)}catch(_){}return id}
      var sid=getSid();
      function track(name,meta){try{var payload=JSON.stringify({events:[{session_id:sid,event_name:name,source:'marketing',page:location.pathname,referrer:document.referrer||'',metadata:meta||{}}]});if(navigator.sendBeacon){navigator.sendBeacon(API+'/api/track',new Blob([payload],{type:'application/json'}))}else{fetch(API+'/api/track',{method:'POST',headers:{'Content-Type':'application/json'},body:payload,keepalive:true}).catch(function(){})}}catch(_){}}
      track('page_view',{title:document.title});
      document.addEventListener('click',function(e){var el=e.target.closest('a,button');if(!el)return;var label=el.getAttribute('data-track')||el.innerText.trim().slice(0,60);track('click',{label:label,tag:el.tagName.toLowerCase()})});
      window._gtrack=track;
    })();

    /* ── REFERRAL TRACKING ── */
    (function(){
      var params=new URLSearchParams(window.location.search),urlRef=params.get('ref');
      if(urlRef)document.cookie='grassion_ref='+encodeURIComponent(urlRef)+';max-age='+(30*24*60*60)+';path=/;SameSite=Lax';
      var m=document.cookie.match(/(?:^|;\s*)grassion_ref=([^;]+)/),ref=m?decodeURIComponent(m[1]):null;
      if(!ref)return;
      document.querySelectorAll('a[href*="auth/github"]').forEach(function(a){var u=new URL(a.getAttribute('href'),window.location.href);u.searchParams.set('ref',ref);a.setAttribute('href',u.toString());});
    })();
  </script>

