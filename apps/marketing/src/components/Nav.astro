---
const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://app.grassion.com'
const links = [
  { href: '/about/', label: 'About' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/contact/', label: 'Contact' },
]
---

<header class="border-b border-[#1a1a1a]">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2">
      <img src="/W+L.png" alt="Grassion" style="height:28px;" onerror="this.style.display='none'" />
    </a>
    <nav class="flex items-center gap-6 text-sm">
      {links.map((l) => (
        <a href={l.href} class="text-[#aaa] hover:text-white">{l.label}</a>
      ))}
      <a
        href={APP_URL}
        class="rounded-md bg-white px-3 py-1.5 text-[#0a0a0a] hover:bg-neutral-100"
      >
        Sign in
      </a>
    </nav>
  </div>
</header>
