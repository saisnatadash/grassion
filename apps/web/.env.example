# ── Grassion Web (React + Vite) — environment variables ───────────────────────
# Copy to .env and fill in real values. Never commit real secrets.

# API base URL — Vite exposes VITE_* vars to the browser
VITE_API_URL=http://localhost:3001
VITE_APP_URL=http://localhost:5173

# GitHub OAuth App client ID (public — only the ID, never the secret)
VITE_GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx

# Razorpay publishable key ID (public)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
