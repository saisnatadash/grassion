# ── Grassion API — environment variables ──────────────────────────────────────
# Copy to .env and fill in real values. Never commit real secrets.

# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/grassion

# GitHub App
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_APP_CLIENT_SECRET=github_client_secret_here
GITHUB_APP_WEBHOOK_SECRET=github_webhook_secret_here
GITHUB_APP_SLUG=grassion

# JWT session signing (32+ chars required)
JWT_SECRET=change_me_to_a_random_32plus_character_string
SESSION_COOKIE_DOMAIN=.grassion.com

# Razorpay billing
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret_here
RAZORPAY_PLAN_ID_STARTER=plan_xxxxxxxxxxxxxxxx

# Zoho SMTP (digest + contact form emails)
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=hello@grassion.com
ZOHO_SMTP_PASS=zoho_smtp_password_here
ZOHO_FROM_ADDRESS=hello@grassion.com
ZOHO_TO_ADDRESS=contact@grassion.com

# Public URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
MARKETING_URL=http://localhost:4321

# Resend (optional fallback for email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (PR summaries — optional)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Global daily spend cap in USD (default: 20)
OPENAI_DAILY_CAP_USD=20
# Global monthly spend cap in USD (default: 50)
OPENAI_MONTHLY_CAP_USD=50

# OAuth token encryption key (AES-256-GCM, 32 bytes as hex = 64 hex chars)
# Generate: openssl rand -hex 32
# Without this, OAuth tokens are stored unencrypted (migration path only).
TOKEN_ENCRYPTION_KEY=change_me_to_64_hex_chars_from_openssl_rand_hex_32_placeholder

# Cloudflare Turnstile bot protection (optional — public forms skip check if unset)
# Get from: https://dash.cloudflare.com -> Turnstile -> Create site key (Managed)
# Frontend also needs the sitekey set in VITE_CF_TURNSTILE_SITE_KEY
CF_TURNSTILE_SECRET_KEY=change_me_turnstile_secret_key_here

# Admin endpoints (optional — disabled if unset)
ADMIN_SECRET=change_me_admin_secret

# Slack slash commands
SLACK_SIGNING_SECRET=slack_signing_secret_here

# Demo mode — set to "true" to enable /api/demo/* regardless of plan
DEMO_MODE=false

# Sentry error reporting (optional)
# When set, wire Sentry.init() in lib/monitoring.ts to send errors + alerts.
# See: https://docs.sentry.io/platforms/node/
SENTRY_DSN=
