# ── Grassion Worker — environment variables ───────────────────────────────────
# Copy to .env and fill in real values. Never commit real secrets.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Database (Neon Postgres — same DB as the API)
DATABASE_URL=postgresql://user:password@host/grassion

# GitHub App (required for outcome tracker to call GitHub API)
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Email (Resend — weekly digest)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=digest@grassion.com

# OpenAI (PR summaries — optional)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# Monthly spend cap in USD — worker skips summaries once exceeded (default: 10)
OPENAI_MONTHLY_BUDGET_USD=10
# Daily spend cap in USD — global across all teams (default: 20)
OPENAI_DAILY_CAP_USD=20

# Public app URL — used in digest email links
APP_URL=https://app.grassion.com

# Worker health-check HTTP port (default: 8081)
WORKER_HEALTH_PORT=8081

# Cron schedules (default values shown)
OUTCOME_CRON=0 */6 * * *
WEEKLY_DIGEST_CRON=0 9 * * 1

# Admin alert email (optional — receives circuit-breaker alerts)
ADMIN_ALERT_EMAIL=alerts@grassion.com
