# ── Grassion MCP Server — environment variables ───────────────────────────────
# Copy to .env and fill in real values. Never commit real secrets.
# The MCP server typically runs as a subprocess of the AI coding tool (Cursor/Claude),
# so these values are usually set in the tool's MCP server configuration.

# Database (Neon Postgres — same DB as the API)
DATABASE_URL=postgresql://user:password@host/grassion

# MCP API token — issued from app.grassion.com/settings/mcp (Pro plan required)
# Format: gmc_<base64url(32 bytes)>
GRASSION_API_TOKEN=gmc_your_token_here
